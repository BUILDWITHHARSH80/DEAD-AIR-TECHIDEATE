# Supabase PostgreSQL connection string (Use port 6543 for Supavisor transaction pooler)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase API URL and Service Role Key (Required for Supabase Storage)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
SUPABASE_STORAGE_BUCKET=evidence

# Mandatory Secret Key for JWT Token Generation (Keep safe!)
DEAD_AIR_SECRET=your-cryptographically-secure-random-secret-key-32-chars-min

# Allowed CORS Origins (Comma-separated, e.g., local Vite dev server and Vercel production domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-app.vercel.app

# Server Port (Optional, defaults to 8000)
PORT=8000
